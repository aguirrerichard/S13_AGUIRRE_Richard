# Copia este archivo como .env y completa TUS valores. El .env NUNCA se sube a GitHub.
PORT=3000

# Cadena de conexión de Neon (Dashboard > Connect). Ejemplo de forma:
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST.neon.tech/BASE?sslmode=require
DB_SSL=true

# Clave para firmar los tokens JWT: una frase larga y aleatoria
JWT_SECRET=escribe-aqui-una-clave-larga-y-secreta
JWT_EXPIRA=8h

# Origen(es) del frontend permitidos por CORS, separados por coma.
# Local: http://localhost:5173   |   Publicado: https://tu-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# true = un empleado solo puede dictaminar/eliminar dentro de su turno (regla del parcial)
VALIDAR_TURNO=true
